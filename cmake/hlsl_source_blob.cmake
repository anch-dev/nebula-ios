# Writes HEADER: `const unsigned char NAME[]`, a D3D12-layer shader blob that
# carries HLSL source (runtime/src/d3d12/compiler.cpp: "GXHS"), the stand-in
# for an fxc /Fh bytecode header on Apple/Linux hosts.
#   -DSOURCE=<hlsl> -DHEADER=<out.h> -DNAME=<symbol> -DSTAGE=v|p -DENTRY=<entry>

function(u32_hex value out)
    set(text "")
    foreach(shift 0 8 16 24)
        math(EXPR byte "(${value} >> ${shift}) & 255" OUTPUT_FORMAT HEXADECIMAL)
        string(APPEND text "${byte},")
    endforeach()
    set(${out} "${text}" PARENT_SCOPE)
endfunction()

function(string_hex text out)
    string(LENGTH "${text}" length)
    u32_hex(${length} prefix)
    string(HEX "${text}" hex)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," body "${hex}")
    set(${out} "${prefix}${body}" PARENT_SCOPE)
endfunction()

if(STAGE STREQUAL "v")
    set(stage_value 0)
elseif(STAGE STREQUAL "p")
    set(stage_value 1)
else()
    message(FATAL_ERROR "hlsl_source_blob: unknown stage ${STAGE}")
endif()

file(READ "${SOURCE}" source_hex HEX)
string(LENGTH "${source_hex}" source_hex_length)
math(EXPR source_length "${source_hex_length} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," source_bytes "${source_hex}")

u32_hex(1397250119 magic)   # "GXHS"
u32_hex(1 version)
u32_hex(${stage_value} stage)
string_hex("${ENTRY}" entry)
get_filename_component(label "${SOURCE}" NAME)
string_hex("${label}" label_bytes)
u32_hex(${source_length} source_size)

file(WRITE "${HEADER}"
    "// Generated by cmake/hlsl_source_blob.cmake from ${label}.\n"
    "#pragma once\n"
    "const unsigned char ${NAME}[] = {\n"
    "${magic}${version}${stage}${entry}${label_bytes}${source_size}${source_bytes}\n"
    "};\n")
